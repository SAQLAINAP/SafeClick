{
  "manifest_version": 3,
  "name": "HackSky AI Detector",
  "version": "1.1.0",
  "description": "AI-powered threat interception system for detecting fake content and honeytraps",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "HackSky AI Detector"
  }
}
